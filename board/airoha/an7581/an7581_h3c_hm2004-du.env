#include <env/airoha/an758x.env>
#include <env/airoha/an758x-ubi.env>
loadaddr=0x90000000
console=earlycon=uart8250,mmio32,0x11002000 console=ttyS0
bootfile=ponwrt-airoha-an7581-h3c_hm2004-du-initramfs-recovery.itb
bootfile_bl2=an7581-h3c-hm2004-du-preloader.bin
bootfile_fip=an7581-h3c-hm2004-du-bl31-u-boot.fip
bootfile_upg=ponwrt-airoha-an7581-h3c_hm2004-du-squashfs-sysupgrade.itb
bootled_status=green:power
bootmenu_title=U-Boot HM2004-DU
preboot=led $bootled_status on ; run ethaddr_factory
# eth0 MAC lives in slot 0x20 of the board-data volume (Linux mac-eth0@20);
# this is the same L2 domain that recovery networking uses.
ethaddr_factory=run ubi_mount && ubi read 0x90000000 factory && env readmem -b ethaddr 0x90000020 0x6 || true
